# Public analytics configuration. Leave empty to disable a provider.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile. Use Cloudflare's documented test keys locally if needed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact delivery. CONTACT_DELIVERY_MODE=mock works only in local development.
CONTACT_DELIVERY_MODE=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Thirty Seven inquiries <inquiries@37.technology>
CONTACT_TO_EMAIL=info@37.technology
