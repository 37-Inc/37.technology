{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirty-seven-website-preview",
  "account_id": "7f05a1dcb6e16f9c239564a0293bbe74",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare-build/site/out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/legal/privacy/faxit",
      "/legal/privacy/faxit/",
      "/legal/terms/faxit",
      "/legal/terms/faxit/",
    ],
  },
  "vars": {
    "DEPLOYMENT_ENV": "preview",
    "CONTACT_FROM_EMAIL": "Thirty Seven inquiries <inquiries@37.technology>",
    "CONTACT_TO_EMAIL": "info@37.technology",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "production": {
      "name": "thirty-seven-website",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_ENV": "production",
        "CONTACT_FROM_EMAIL": "Thirty Seven inquiries <inquiries@37.technology>",
        "CONTACT_TO_EMAIL": "info@37.technology",
      },
    },
  },
}
